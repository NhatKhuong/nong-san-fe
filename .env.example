# Sao chép file này thành `.env` rồi chỉnh theo môi trường của bạn.
# KHÔNG commit file `.env` — nó đã nằm trong .gitignore.

# Gốc API của backend Spring Boot.
# Để trống thì axios dùng mặc định "/api" (đi qua proxy cấu hình trong vite.config.ts).
VITE_API_BASE_URL=

# Gốc URL của kho ảnh.
# Để TRỐNG khi phát triển: ảnh lấy từ thư mục public/ của chính web.
# Khi đưa ảnh lên S3/CDN thì điền vào, ví dụ:
#   VITE_IMAGE_BASE_URL=https://cdn.nongsansach.vn
# Dữ liệu vẫn chỉ lưu đường dẫn tương đối (/images/...), không cần sửa gì thêm.
VITE_IMAGE_BASE_URL=

# Gốc URL của chính trang web, ví dụ: https://nongsansach.vn
# Dùng để dựng URL TUYỆT ĐỐI cho thẻ og:image khi chia sẻ lên mạng xã hội.
# Để trống thì thẻ ảnh bị bỏ qua hoàn toàn — Facebook và X không đọc được đường
# dẫn tương đối, nên thà không có thẻ còn hơn có một thẻ sai.
VITE_SITE_URL=
